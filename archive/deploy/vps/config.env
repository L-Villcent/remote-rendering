# Deployment parameters (reviewed by the user before any --apply run).
GATES_VERSION=0.1.0
CLAUDE_USER=claude-agent
CLAUDE_GROUP=render-claude
WORKER_USER=render-worker
PUBLISH_USER=render-publish
INGEST_USER=render-ingest
NETCHECK_USER=render-netcheck
IMAGE_DIR=/var/lib/render-images
IMG_UP_GIB=4
IMG_DOWN_GIB=2
IMG_DATA_GIB=6
IMG_AGENT_GIB=12
ROOT_RESERVE_GIB=10
ROOT_RESERVE_PCT=20
CLAUDE_CODE_DIR=/opt/claude-code      # admin installs the reviewed Claude Code binary here
FFMPEG_DIR=/opt/ffmpeg                # optional, read-only inside the sandbox
SANDBOX_TMP_MB=512
