# Well-known reserved ranges and public resolver addresses used by sshd source
# restrictions and the sandbox egress rules.  They are standards constants
# (RFC 6598 / RFC 1918 / RFC 4193 / Tailscale's documented ranges / public DNS),
# NOT information about the local machine.  This is the only file that is
# expected to contain address literals; package scans list it explicitly.
TAILNET_V4="100.64.0.0/10"
TAILNET_V6="fd7a:115c:a1e0::/48"
DENY_V4="0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4"
DENY_V6="::1/128, ::ffff:0:0/96, fc00::/7, fe80::/10, ff00::/8"
# Sandbox DNS (choose and review; default: Quad9).  MagicDNS is never used inside the sandbox.
SANDBOX_RESOLVERS_V4="9.9.9.9, 149.112.112.112"
SANDBOX_RESOLVERS_V6="2620:fe::fe, 2620:fe::9"
# Synthetic address used only by 80-verify to ask sshd -T about a Tailnet-sourced session.
VERIFY_TAILNET_ADDR="100.64.0.1"
LOOPBACK_V4="127.0.0.1"
LOOPBACK_V6="::1"
# Synthetic RFC 5737 documentation addresses used by the SB canaries (never real hosts).
SYNTH_DOC_V4_A="203.0.113.10"
SYNTH_DOC_V4_B="203.0.113.20"
METADATA_V4="169.254.169.254"
MAGICDNS_V4="100.100.100.100"
PRIVATE_SAMPLE_V4="10.0.0.1"
