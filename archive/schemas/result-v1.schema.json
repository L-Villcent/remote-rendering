{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:render-protocol:result:v1",
  "title": "Attempt result v1, ingest record (= ack) and reason codes",
  "description": "Root = up/jobs/<job_id>/<attempt_id>/result.json (uploaded last). $defs.ingest_record is written by render-ingest to BOTH down/acks/<job_id>/<attempt_id>.json (Worker) and inbox/jobs/<job_id>/<attempt_id>/ingest.json (Claude); it never echoes matched values. Observation fields are explicit null when unknown; null never means false. Cross-field rules XF-R* in protocol-v1 section 10.",
  "$ref": "#/$defs/result",

  "$defs": {
    "job_id": { "type": "string", "pattern": "^j_[0-9A-HJKMNP-TV-Z]{26}$" },
    "attempt_id": { "type": "string", "pattern": "^a_[0-9A-HJKMNP-TV-Z]{26}$" },
    "artifact_id": { "type": "string", "pattern": "^(log|keyframe|contact|preview|final)(-[0-9]{1,6})?$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semver": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$" },
    "utc_time": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "error_class": {
      "enum": ["validation_error", "adapter_error", "timeout", "gpu_oom", "disk_full", "cancelled", "worker_lost", "upload_error", "internal"]
    },

    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version", "kind", "job_id", "attempt_id", "attempt_no", "worker_epoch",
        "outcome", "phase_reached", "exit", "error_class", "bundle_sha256", "adapter", "toolchain",
        "device", "frames", "timings_ms", "artifacts", "local_text_check"
      ],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "result" },
        "job_id": { "$ref": "#/$defs/job_id" },
        "attempt_id": { "$ref": "#/$defs/attempt_id" },
        "attempt_no": { "type": "integer", "minimum": 1, "maximum": 3 },
        "worker_epoch": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["succeeded", "failed", "cancelled"] },
        "phase_reached": { "enum": ["validate", "prepare", "render", "encode", "upload"], "$comment": "Last phase entered. 'upload' = all work done." },
        "retry_scheduled": { "type": "boolean", "$comment": "true only with outcome=failed and a retryable error_class; see XF-R19." },
        "exit": {
          "$comment": "Renderer process exit. Windows native codes are DWORD (0..4294967295) and are reported unchanged; POSIX signals use kind=signaled.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "code", "signal"],
          "properties": {
            "kind": { "enum": ["not_started", "exited", "signaled", "terminated_by_worker", "unknown"] },
            "code": { "oneOf": [ { "type": "integer", "minimum": 0, "maximum": 4294967295 }, { "type": "null" } ] },
            "signal": { "oneOf": [ { "type": "integer", "minimum": 1, "maximum": 128 }, { "type": "null" } ] }
          },
          "allOf": [
            { "if": { "properties": { "kind": { "const": "exited" } } }, "then": { "properties": { "code": { "type": "integer" }, "signal": { "type": "null" } } } },
            { "if": { "properties": { "kind": { "const": "signaled" } } }, "then": { "properties": { "code": { "type": "null" }, "signal": { "type": "integer" } } } },
            { "if": { "properties": { "kind": { "const": "not_started" } } }, "then": { "properties": { "code": { "type": "null" }, "signal": { "type": "null" } } } }
          ]
        },
        "error_class": { "oneOf": [ { "$ref": "#/$defs/error_class" }, { "type": "null" } ] },
        "bundle_sha256": { "oneOf": [ { "$ref": "#/$defs/sha256" }, { "type": "null" } ], "$comment": "Expected value from job.json; null only if job.json itself was unusable (XF-R02)." },
        "adapter": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version"],
              "properties": {
                "id": { "enum": ["webgl-frames"] },
                "version": { "$ref": "#/$defs/semver" }
              }
            },
            { "type": "null" }
          ]
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["worker_version", "toolchain_id", "browser", "encoder"],
          "properties": {
            "worker_version": { "$ref": "#/$defs/semver" },
            "toolchain_id": {
              "oneOf": [ { "type": "string", "pattern": "^tc-[a-z0-9-]{1,32}$" }, { "type": "null" } ],
              "$comment": "Registered in /etc/render/toolchains.json (admin) with full versions and executable hashes."
            },
            "browser": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "major", "exe_sha256"],
                  "properties": {
                    "name": { "enum": ["chromium", "chrome", "edge"] },
                    "major": { "type": "integer", "minimum": 1, "maximum": 999 },
                    "exe_sha256": { "$ref": "#/$defs/sha256" }
                  }
                },
                { "type": "null" }
              ]
            },
            "encoder": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "version", "exe_sha256"],
                  "properties": {
                    "name": { "const": "ffmpeg" },
                    "version": { "type": "string", "pattern": "^[0-9]{1,2}\\.[0-9]{1,2}(\\.[0-9]{1,2})?$" },
                    "exe_sha256": { "$ref": "#/$defs/sha256" }
                  }
                },
                { "type": "null" }
              ]
            }
          }
        },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gpu_query", "gpu_vendor", "gpu_model", "software_fallback", "gpu_busy_observed", "vram_peak_mb"],
          "properties": {
            "gpu_query": { "enum": ["available", "unavailable", "not_attempted"] },
            "gpu_vendor": { "oneOf": [ { "enum": ["nvidia", "amd", "intel", "other"] }, { "type": "null" } ] },
            "gpu_model": {
              "$comment": "Charset limit only narrows the field; it is NOT a guarantee that no address can be encoded (e.g. space-separated digits pass). Privacy relies on source isolation plus text rules.",
              "oneOf": [ { "type": "string", "maxLength": 48, "pattern": "^[A-Za-z][A-Za-z0-9 +-]{0,47}$" }, { "type": "null" } ]
            },
            "software_fallback": { "type": ["boolean", "null"] },
            "gpu_busy_observed": { "type": ["boolean", "null"] },
            "vram_peak_mb": { "oneOf": [ { "type": "integer", "minimum": 0 }, { "type": "null" } ] }
          }
        },
        "frames": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected", "rendered"],
          "properties": {
            "expected": { "oneOf": [ { "type": "integer", "minimum": 0 }, { "type": "null" } ], "$comment": "null ONLY when the job definition was unavailable (see allOf branch); the Worker never guesses." },
            "rendered": { "type": "integer", "minimum": 0 }
          }
        },
        "timings_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total"],
          "properties": {
            "prepare": { "type": "integer", "minimum": 0 },
            "render": { "type": "integer", "minimum": 0 },
            "encode": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 24,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "local_text_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rules_version", "passed"],
          "properties": {
            "rules_version": { "type": "integer", "minimum": 1 },
            "passed": { "type": "boolean" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "succeeded" } } },
          "then": {
            "properties": {
              "phase_reached": { "const": "upload" },
              "exit": { "properties": { "kind": { "const": "exited" }, "code": { "const": 0 } } },
              "error_class": { "type": "null" },
              "retry_scheduled": { "const": false },
              "bundle_sha256": { "$ref": "#/$defs/sha256" },
              "adapter": { "type": "object" },
              "toolchain": { "properties": { "toolchain_id": { "type": "string" }, "browser": { "type": "object" } } },
              "device": { "properties": { "software_fallback": { "const": false } } }
            }
          }
        },
        {
          "$comment": "Job definition unavailable: bundle_sha256, adapter and frames.expected are null together, only for an early validation failure.",
          "if": {
            "anyOf": [
              { "properties": { "bundle_sha256": { "type": "null" } } },
              { "properties": { "adapter": { "type": "null" } } },
              { "properties": { "frames": { "properties": { "expected": { "type": "null" } } } } }
            ]
          },
          "then": {
            "properties": {
              "outcome": { "const": "failed" },
              "error_class": { "const": "validation_error" },
              "phase_reached": { "const": "validate" },
              "bundle_sha256": { "type": "null" },
              "adapter": { "type": "null" },
              "frames": { "properties": { "expected": { "type": "null" }, "rendered": { "const": 0 } } }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "cancelled" } } },
          "then": { "properties": { "error_class": { "const": "cancelled" }, "retry_scheduled": { "const": false } } }
        },
        {
          "if": { "properties": { "outcome": { "const": "failed" } } },
          "then": { "properties": { "error_class": { "$ref": "#/$defs/error_class", "not": { "const": "cancelled" } } } }
        }
      ]
    },

    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "media_type", "delivery"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/artifact_id" },
        "kind": { "enum": ["log", "keyframe", "contact", "preview", "final"] },
        "media_type": { "enum": ["text/plain", "image/png", "video/mp4"] },
        "export_profile": { "enum": ["png-rgb8-v1", "h264-preview-v1", "h264-final-v1"] },
        "frame_index": { "type": "integer", "minimum": 0 },
        "delivery": { "enum": ["uploaded", "retained_local"] },
        "over_upload_cap": { "const": true, "$comment": "Only on kind=final with final_delivery=upload that exceeded the upload cap and was kept locally (XF-R12)." },
        "size_bytes": { "type": "integer", "minimum": 0, "$comment": "Upload caps per kind are XF-R11; retained_local sizes are informational and uncapped." },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "delivery": { "const": "uploaded" } } },
          "then": { "required": ["size_bytes", "sha256"], "properties": { "size_bytes": { "maximum": 209715200 } } }
        },
        {
          "if": { "properties": { "media_type": { "enum": ["image/png", "video/mp4"] } } },
          "then": { "required": ["export_profile"] }
        }
      ]
    },

    "reason_code": {
      "anyOf": [
        {
          "enum": [
            "TX-IPV4", "TX-IPV6", "TX-MAC", "TX-WINPATH", "TX-POSIXPATH", "TX-ENVDUMP", "TX-SECRET", "TX-TAILNET", "TX-TZ",
            "schema_invalid", "malformed_json", "size_exceeded", "hash_mismatch", "missing_artifact", "unreadable",
            "not_regular_file", "profile_mismatch", "structure_limit_exceeded", "toolchain_unregistered",
            "attempt_conflict", "attempt_limit_exceeded", "superseded_attempt", "retry_limit", "identity_conflict",
            "outcome_mismatch"
          ]
        },
        { "type": "string", "pattern": "^XF-[JBRSH][0-9]{2}$" }
      ]
    },

    "ref": {
      "$comment": "Fixed object names, artifact ids, and JSON Pointers built ONLY from property names defined in the v1 schemas (vocabulary checked by tests). Unknown keys are reported as schema_invalid with a file-level ref, never as a pointer.",
      "type": "string",
      "maxLength": 128,
      "pattern": "^(result\\.json|status\\.json|heartbeat\\.json|submission\\.json|job\\.json|bundle|handoff|(log|keyframe|contact|preview|final)(-[0-9]{1,6})?)(#(/(accepted_epoch|accepted_seq|active_attempt_id|active_job_id|adapter|adapters|artifact_id|artifacts|attempt_id|attempt_no|attempts_seen|browser|bundle|bundle_sha256|cache_hit|cancel|capabilities|checked_at|code|created_at|current_attempt|delivery|device|disk_free_class|display_state|elapsed_ms|encode|encoder|entry_count|entrypoint|error_class|error_code|exe_sha256|exec_state|exit|expected|export|export_profile|export_profiles|final_delivery|format|fps|frame_end_exclusive|frame_index|frame_start|frames|frames_done|frames_total|gpu_busy_observed|gpu_model|gpu_query|gpu_vendor|health|height|id|idempotency_key|identity_sha256|ingest_version|issued_at|job_id|keyframes|kind|known|last_epoch|last_received_at|last_seq|last_status_seq|limits|local_text_check|major|max_attempts|max_concurrent|max_upload_mb|media_type|name|network_policy|online|outcome|over_upload_cap|overlays|params|parent_job_id|passed|path|phase_reached|prepare|profiles|profiles_version|progress|project_id|protocol_version|publish_rules_version|reachable|reasons|received_at|ref|rejected_count|render|rendered|report_id|request_id|requested_at|retry_allowed|retry_scheduled|rule|rules_version|seed|seq|sha256|signal|size_bytes|software_fallback|stage|state|timeout_seconds|timings_ms|toolchain|toolchain_id|total|updated_at|verdict|version|vram_peak_mb|width|worker_alias|worker_epoch|worker_version|[0-9]{1,2}))*)?$"
    },

    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "ref"],
      "properties": {
        "rule": { "$ref": "#/$defs/reason_code" },
        "ref": { "$ref": "#/$defs/ref" }
      }
    },

    "ingest_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "job_id", "attempt_id", "attempt_no", "received_at", "verdict", "retry_allowed", "rejected_count", "reasons", "rules_version", "profiles_version", "ingest_version"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "ingest_record" },
        "job_id": { "$ref": "#/$defs/job_id" },
        "attempt_id": { "$ref": "#/$defs/attempt_id" },
        "attempt_no": { "oneOf": [ { "type": "integer", "minimum": 1 }, { "type": "null" } ], "$comment": "r5.1: null only for an unattributable delivery (verdict=conflict)." },
        "received_at": { "$ref": "#/$defs/utc_time" },
        "verdict": { "enum": ["accepted", "quarantined", "rejected", "delivery_failed", "stale", "conflict"] },
        "retry_allowed": { "type": "boolean" },
        "rejected_count": { "type": "integer", "minimum": 0 },
        "reasons": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/reason" } },
        "rules_version": { "type": "integer", "minimum": 1 },
        "profiles_version": { "type": "integer", "minimum": 1 },
        "ingest_version": { "$ref": "#/$defs/semver" },
        "cache_hit": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "verdict": { "const": "rejected" } } }, "then": { "properties": { "retry_allowed": { "const": true }, "reasons": { "minItems": 1 } } }, "else": { "properties": { "retry_allowed": { "const": false } } } },
        { "if": { "properties": { "verdict": { "const": "accepted" } } }, "then": { "properties": { "reasons": { "maxItems": 0 } } }, "else": { "properties": { "reasons": { "minItems": 1 } } } },
        { "if": { "properties": { "attempt_no": { "type": "null" } } }, "then": { "properties": { "verdict": { "const": "conflict" } } } }
      ]
    },

    "handoff_record": {
      "$comment": "r5.1: inbox/handoff/<report_id>.record.json (Claude) and down/acks/_handoff/<report_id>.json (Worker), written by render-ingest. Never echoes matched values.",
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "report_id", "verdict", "reasons", "received_at"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "handoff_record" },
        "report_id": { "type": "string", "pattern": "^local-[0-9]{8}-[0-9]{2}$" },
        "verdict": { "enum": ["accepted", "quarantined"] },
        "reasons": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/reason" } },
        "received_at": { "$ref": "#/$defs/utc_time" }
      },
      "if": { "properties": { "verdict": { "const": "accepted" } } },
      "then": { "properties": { "reasons": { "maxItems": 0 } } },
      "else": { "properties": { "reasons": { "minItems": 1 } } }
    }
  }
}
